{
  "name": "shunpo",
  "version": "1.3.0",
  "description": "LoL Account Manager",
  "main": "./out/main/index.js",
  "author": "FlayInAHook",
  "homepage": "https://github.com/FlayInAHook/shunpo",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlayInAHook/shunpo.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "bunx tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "bunx tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun run typecheck && electron-vite build",
    "build:native": "cd native && node-gyp rebuild && node -e \"require('fs').copyFileSync('build/Release/overlay_window.node', '../resources/overlay_window.node')\"",
    "postinstall": "bun run build:native && electron-builder install-app-deps",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "publish": "bun run build && electron-builder --publish=always",
    "publish:win": "bun run build && electron-builder --win --publish=always",
    "publish:mac": "electron-vite build && electron-builder --mac --publish=always",
    "publish:linux": "electron-vite build && electron-builder --linux --publish=always",
    "generate:theme": "bunx chakra typegen ./src/renderer/src/theme/theme.ts"
  },
  "dependencies": {
    "@chakra-ui/cli": "^3.36.0",
    "@chakra-ui/react": "^3.36.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@hasagi/core": "^0.6.11",
    "chakra-react-select": "^6.1.3",
    "electron-updater": "^6.8.9",
    "jotai": "^2.20.1",
    "next-themes": "^0.4.6",
    "react-hotkeys-hook": "^5.3.3",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "22.15.31",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "node-gyp": "^11.4.2",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
